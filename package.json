{
  "name": "vedacore",
  "version": "2.0.0",
  "main": "main.js",
  "scripts": {
    "start": "set ELECTRON_RUN_AS_NODE=&& electron .",
    "build": "set ELECTRON_RUN_AS_NODE=&& electron-builder"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0"
  },
  "dependencies": {
    "mysql2": "^3.24.6"
  },
  "build": {
    "appId": "br.com.vedacore",
    "productName": "VedaCore",
    "npmRebuild": false,
    "asarUnpack": [
      "**/*.node"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "license": "LICENSE.txt"
    }
  }
}
